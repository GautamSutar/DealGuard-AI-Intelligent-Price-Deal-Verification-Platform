# ============================================================
# DealGuard Backend — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://dealguard:dealguard_secret@localhost:5432/dealguard
POSTGRES_USER=dealguard
POSTGRES_PASSWORD=dealguard_secret
POSTGRES_DB=dealguard

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- AI Provider ---
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# --- Amazon Marketplace Provider ---
# Options: keepa | mock (for development without a paid key)
AMAZON_PROVIDER=mock
KEEPA_API_KEY=your_keepa_api_key_here

# --- Flipkart Marketplace Provider (V2) ---
# Options: rapidapi | mock
FLIPKART_PROVIDER=mock
FLIPKART_API_KEY=your_flipkart_api_key_here

# --- App Settings ---
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secret_key_in_production
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# --- Price Collection ---
PRICE_COLLECTION_INTERVAL_HOURS=6
PRICE_CACHE_TTL_SECONDS=900

# --- Rate Limiting ---
PROVIDER_RATE_LIMIT_PER_MINUTE=30
