# ============================================================
# DealGuard Backend — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://dealguard:dealguard_secret@localhost:5432/dealguard
POSTGRES_USER=dealguard
POSTGRES_PASSWORD=dealguard_secret
POSTGRES_DB=dealguard

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- AI Provider ---
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# --- Amazon Marketplace Provider ---
# Options: rapidapi | mock
# Set to 'rapidapi' to use live RapidAPI Amazon data (recommended)
# Set to 'mock' for development without any API key
AMAZON_PROVIDER=rapidapi

# RapidAPI key (get from https://rapidapi.com)
RAPIDAPI_KEY=your_rapidapi_key_here

# RapidAPI Amazon host — matches the service you subscribed to on RapidAPI.
# Common options (pick the one you subscribed to):
#   real-time-amazon-data.p.rapidapi.com   ← most popular, free tier available
#   amazon-product-data6.p.rapidapi.com
#   axesso-amazon-data-service.p.rapidapi.com
RAPIDAPI_AMAZON_HOST=real-time-amazon-data.p.rapidapi.com

# Country code for marketplace (IN = Amazon India, US = Amazon US, etc.)
RAPIDAPI_AMAZON_COUNTRY=IN

# Keepa (paid historical data — optional, for future use)
KEEPA_API_KEY=your_keepa_api_key_here

# --- ReefAPI (Flipkart + 293 other APIs) ---
# Get a free key (1,000 credits) at https://reefapi.com
# One key covers all ReefAPI endpoints.
REEFAPI_KEY=your_reefapi_key_here

# --- Flipkart Marketplace Provider ---
# Options: reefapi | mock
# Set to 'reefapi' to use live Flipkart data via ReefAPI.
# Set to 'mock' for development without an API key.
FLIPKART_PROVIDER=reefapi

# --- App Settings ---
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secret_key_in_production
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# --- Price Collection ---
PRICE_COLLECTION_INTERVAL_HOURS=6
PRICE_CACHE_TTL_SECONDS=900

# --- Rate Limiting ---
PROVIDER_RATE_LIMIT_PER_MINUTE=30
